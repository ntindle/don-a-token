# E2B Cloud:
E2B_API_KEY=e2b_***

# E2B Embed (local or remote node) — uncomment to build against Embed:
# E2B_API_URL=http://127.0.0.1:3000
# E2B_API_KEY=<embed-install-key>
# E2B_SANDBOX_URL is REQUIRED for any sandbox interaction (commands.run,
# verify.mjs): without it the JS SDK builds cloud-style
# https://49983-<id>.<domain> URLs and every call fails with
# "Sandbox is probably not running anymore".
# E2B_SANDBOX_URL=http://127.0.0.1:3002
