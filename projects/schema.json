{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ntindle/don-a-token/blob/main/projects/schema.json",
  "title": "don-a-token projects registry",
  "type": "object",
  "required": ["version", "updated_at", "projects"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "repo", "description", "homepage", "status", "required_providers", "work_categories", "job"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "pattern": "^https://github\\.com/" },
          "description": { "type": "string", "minLength": 1 },
          "homepage": { "type": "string" },
          "status": { "enum": ["active", "paused"] },
          "required_providers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["none", "github", "gitlab"] },
                "push_endpoint": {
                  "type": "string",
                  "description": "Where to push results when kind is none."
                }
              }
            }
          },
          "work_categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "tier"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "tier": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Model tier required for this category, e.g. frontier, terra."
                },
                "description": { "type": "string" },
                "prompt_pack": {
                  "type": "string",
                  "description": "Category prompt pack; defaults to the job-level one."
                }
              }
            }
          },
          "job": {
            "type": "object",
            "required": ["kind", "template", "max_tokens_per_job", "max_minutes_per_job", "checks", "prompt_pack", "contribution"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "template": { "type": "string", "minLength": 1 },
              "max_tokens_per_job": { "type": "integer", "minimum": 1 },
              "max_minutes_per_job": { "type": "integer", "minimum": 1 },
              "checks": { "type": "array", "items": { "type": "string" } },
              "local_toolchain": {
                "type": "string",
                "description": "Local-backend only: RUSTUP_TOOLCHAIN value forcing the donor machine's cargo at the project's pinned toolchain (the E2B image owns its own toolchain)."
              },
              "maintainer_notes": {
                "type": "string",
                "description": "Maintainer-to-donor guidance shown in Setup: stack used, what jobs leave behind, what to install when running many jobs."
              },
              "prompt_pack": { "type": "string", "minLength": 1 },
              "contribution": {
                "type": "object",
                "required": ["method", "base_branch", "attribution_footer"],
                "properties": {
                  "method": { "type": "string", "minLength": 1 },
                  "base_branch": { "type": "string", "minLength": 1 },
                  "attribution_footer": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    }
  }
}
